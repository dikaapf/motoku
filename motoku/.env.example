# Copy to .env and adjust the values before running in production.
MOTOKU_SECRET_KEY=change-me-in-production
MOTOKU_HOST=127.0.0.1
MOTOKU_PORT=5000
MOTOKU_DEBUG=0

# Optional HTTP Basic auth. Leave both empty to disable.
MOTOKU_AUTH_USER=
MOTOKU_AUTH_PASSWORD=

# Outbound HTTP timeout in seconds.
MOTOKU_HTTP_TIMEOUT=10

# SQLite database path.
MOTOKU_DB_PATH=./data/motoku.db

# CSRF protection for state-changing requests.
MOTOKU_CSRF_ENABLED=1

# Global per-client rate limiting.
MOTOKU_RATE_LIMIT_ENABLED=1
MOTOKU_RATE_LIMIT_REQUESTS=120
MOTOKU_RATE_LIMIT_WINDOW=60

# ── S1: providers, cache, DNS ──
# Redis for shared result cache + daily quota counters. Empty = in-memory.
MOTOKU_REDIS_URL=
# Have I Been Pwned API key (https://haveibeenpwned.com/API/Key).
MOTOKU_HIBP_API_KEY=
# Retry DNS queries over DNS-over-HTTPS when the system resolver returns
# nothing (some networks drop large TXT answers on port 53).
MOTOKU_DNS_DOH_FALLBACK=1
MOTOKU_DOH_URL=https://cloudflare-dns.com/dns-query

# ── S2: infra recon ──
# Background jobs: "thread" (in-process, default) or "rq" (needs Redis + `rq worker motoku`).
MOTOKU_JOB_BACKEND=thread
MOTOKU_JOB_WORKERS=4
# Optional API keys that raise free-tier limits.
MOTOKU_URLSCAN_API_KEY=
MOTOKU_OTX_API_KEY=
MOTOKU_CERTSPOTTER_API_KEY=
# Chromium binary for screenshots (auto-detected when empty).
MOTOKU_CHROMIUM_PATH=

# ── S3: threat intel & enrichment (semua opsional) ──
# Attack surface
MOTOKU_SHODAN_API_KEY=
MOTOKU_CENSYS_API_ID=
MOTOKU_CENSYS_API_SECRET=
MOTOKU_FOFA_API_KEY=
MOTOKU_NETLAS_API_KEY=
# Reputasi & network
MOTOKU_VT_API_KEY=
MOTOKU_ABUSEIPDB_API_KEY=
MOTOKU_GREYNOISE_API_KEY=
MOTOKU_IPINFO_TOKEN=
# Malware & phishing (abuse.ch Auth-Key dipakai URLhaus + MalwareBazaar)
MOTOKU_ABUSECH_API_KEY=
MOTOKU_PHISHTANK_API_KEY=
MOTOKU_GSB_API_KEY=
# Vulnerability
MOTOKU_NVD_API_KEY=
# Leak (GitHub code search butuh token, scope public_repo cukup)
MOTOKU_GITHUB_TOKEN=

# ── S4: people, image & geo ──
MOTOKU_MAX_UPLOAD_MB=16
MOTOKU_OCR_LANGS=eng+ind
MOTOKU_FIRMS_MAP_KEY=
MOTOKU_OPENCORPORATES_TOKEN=
# Reddit app (tipe "script") untuk API profil
MOTOKU_REDDIT_CLIENT_ID=
MOTOKU_REDDIT_CLIENT_SECRET=
# Mirror Overpass, dipisah koma (dicoba berurutan)
MOTOKU_OVERPASS_URLS=

# ── S5: case management, watchlist, alerts ──
# Watchlist scheduler (thread di web app; hanya satu proses yang aktif via lease DB).
MOTOKU_SCHEDULER=1
# Lokasi lampiran case (default data/attachments)
MOTOKU_ATTACHMENT_DIR=
# Tujuan alert global (opsional; per-watch juga bisa diatur)
MOTOKU_ALERT_WEBHOOK=
MOTOKU_ALERT_EMAIL=
MOTOKU_ALERT_MIN_SEVERITY=low
# SMTP untuk alert email
MOTOKU_SMTP_HOST=
MOTOKU_SMTP_PORT=587
MOTOKU_SMTP_USER=
MOTOKU_SMTP_PASSWORD=
MOTOKU_SMTP_FROM=motoku@localhost
MOTOKU_SMTP_STARTTLS=1

# ── S6: bahasa, performa, observability ──
MOTOKU_DEFAULT_LANG=id          # id | en (pengguna bisa memilih di navbar)
MOTOKU_CACHE_WARMUP=1           # muat dataset & katalog KEV saat start
MOTOKU_WARMUP_NETWORK=1
MOTOKU_STATIC_MAX_AGE=86400
MOTOKU_LOG_FORMAT=text          # text | json
MOTOKU_LOG_LEVEL=INFO
MOTOKU_METRICS_TOKEN=           # isi agar /metrics bisa di-scrape tanpa Basic auth
MOTOKU_SENTRY_DSN=              # butuh: pip install sentry-sdk
MOTOKU_JOB_TIMEOUT=1800         # job lebih lama dari ini ditandai gagal
