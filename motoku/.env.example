# Copy to .env and adjust the values before running in production.
MOTOKU_SECRET_KEY=change-me-in-production
MOTOKU_HOST=127.0.0.1
MOTOKU_PORT=5000
MOTOKU_DEBUG=0

# Optional HTTP Basic auth. Leave both empty to disable.
MOTOKU_AUTH_USER=
MOTOKU_AUTH_PASSWORD=

# Outbound HTTP timeout in seconds.
MOTOKU_HTTP_TIMEOUT=10

# SQLite database path.
MOTOKU_DB_PATH=./data/motoku.db

# CSRF protection for state-changing requests.
MOTOKU_CSRF_ENABLED=1

# Global per-client rate limiting.
MOTOKU_RATE_LIMIT_ENABLED=1
MOTOKU_RATE_LIMIT_REQUESTS=120
MOTOKU_RATE_LIMIT_WINDOW=60

# ── S1: providers, cache, DNS ──
# Redis for shared result cache + daily quota counters. Empty = in-memory.
MOTOKU_REDIS_URL=
# Have I Been Pwned API key (https://haveibeenpwned.com/API/Key).
MOTOKU_HIBP_API_KEY=
# Retry DNS queries over DNS-over-HTTPS when the system resolver returns
# nothing (some networks drop large TXT answers on port 53).
MOTOKU_DNS_DOH_FALLBACK=1
MOTOKU_DOH_URL=https://cloudflare-dns.com/dns-query

# ── S2: infra recon ──
# Background jobs: "thread" (in-process, default) or "rq" (needs Redis + `rq worker motoku`).
MOTOKU_JOB_BACKEND=thread
MOTOKU_JOB_WORKERS=4
# Optional API keys that raise free-tier limits.
MOTOKU_URLSCAN_API_KEY=
MOTOKU_OTX_API_KEY=
MOTOKU_CERTSPOTTER_API_KEY=
# Chromium binary for screenshots (auto-detected when empty).
MOTOKU_CHROMIUM_PATH=
